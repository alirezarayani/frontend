{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@frontend-new/shared-ui": [
        "./libs/shared-ui/src/index.ts"
      ],
      "@frontend-new/models": [
        "./libs/models/src/index.ts"
      ],
      "@frontend-new/ui": [
        "./libs/shared/ui/src/index.ts"
      ],
      "@frontend-new/sidebar-layout": [
        "./libs/shared/layout/sidebar-layout/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
